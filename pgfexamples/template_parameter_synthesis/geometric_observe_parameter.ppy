# check_equality pgfexamples/template_parameter_synthesis/geometric_observe_parameter.ppy pgfexamples/template_parameter_synthesis/invariants/geometric_observe_parameter_invariant.ppy
y: nat;
x: nat;
tmp: nat;
param p: real;

while (y == 1) {
    {
        y = 0;
    } [p] {
        y = 1;
    }
    x = x + 1;
    observe(x < 3);
    tmp = 0;
}
