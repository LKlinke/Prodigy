# check_equality pgfexamples/template_parameter_synthesis/negative_binomial_parameter.ppy pgfexamples/template_parameter_synthesis/invariants/negative_binomial_parameter_invariant.ppy
n: nat;
i: nat;
temp: nat;

param p: real;

while (0 < n) {
    {
        n = n - 1;
    } [p] {
        skip;
    }
    i = i + 1;
    temp = 0;
}

#!Plot[i, \infty]
