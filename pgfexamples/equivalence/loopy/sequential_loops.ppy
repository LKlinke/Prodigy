# check_equality pgfexamples/equivalence/loopy/sequential_loops.ppy pgfexamples/equivalence/loopy/invariants/sequential_loops_invariant.ppy
c: nat;
m: nat;
n: nat;
tmp: nat;

while (0 < n) {
    tmp = unif(1, 6);
    m = m + tmp;
    tmp = 0;
    n = n - 1;
}
while (m > 0) {
    {
        m = m + 1;
    } [1/2] {
        m = m - 1;
    }
    c = c + 1;
    tmp = 0;
}
