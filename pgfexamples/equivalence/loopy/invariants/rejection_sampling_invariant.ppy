# skip
# The loop draws geometric(1/2) until the value is odd. It terminates almost surely, so its result
# is geometric(1/2) conditioned on an odd value: P(c = 2j+1) = 3/4 * (1/4)^j. An observe-based
# invariant (`c := geometric(1/2); observe(c%2=1)`) is not one: it keeps only the mass 1/3 of the
# odd values instead of normalising it.
c: nat;

if (c % 2 == 0) {
    c = geometric(3/4);
    c = 2 * c + 1;
} else {
    skip;
}
