# check_equality pgfexamples/equivalence/loopy/nested_while.ppy pgfexamples/equivalence/loopy/invariants/nested_while_invariant1.ppy
x: nat;
y: nat;
c: nat;
temp: nat;

while (x > 0) {
    y = 1;
    while (y == 1) {
        {
            y = 0;
        } [1/2] {
            x = x + 1;
        }
        temp = 0;
    }
    x = x - 1;
    c = c + 1;
}
