# invariant_synthesis pgfexamples/invariant_synthesis/dueling_cowboys.ppy
t: nat;  # t = 0 player A's turn; t = 1 player B's turn; t>1 not interpretable
c: nat;  # c=1, both player alive; c = 0 one player dead; c>1 not interpretable
param a: real;  # probability that Player A shoots player B in a turn.
param b: real;  # probability that Player B shoots player A in a turn.

c = 1;
t = 1;
while (c == 1 and t <= 1) {
    if (t == 0) {
        {
            c = c - 1;
        } [a] {
            t = t + 1;
        }
    } else {
        {
            c = c - 1;
        } [b] {
            t = t - 1;
        }
    }
}
