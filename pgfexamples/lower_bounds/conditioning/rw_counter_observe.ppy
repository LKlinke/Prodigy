# Random walk (down w.p. 2/3) with step counter and conditioning inside the loop: whenever the walk
# is at height x >= 3, a detector fires w.p. 1/2 and we observe that it did NOT fire.
x: nat;
c: nat;
d: nat;
x = 1;
c = 0;
d = 0;
while (x > 0) {
    {
        x = x - 1;
    } [2/3] {
        x = x + 1;
    }
    c = c + 1;
    if (x >= 3) {
        {
            d = 1;
        } [1/2] {
            d = 0;
        }
        observe(d == 0);
    } else {
        skip;
    }
}
query Pr[c >= 20];
query Ex[c];
