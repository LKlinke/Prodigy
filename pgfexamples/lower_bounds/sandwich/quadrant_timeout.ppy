# Two-dimensional random walk in the quadrant with steps SW, W, S, N, E (uniform) and a timeout:
# each round the walk is aborted w.p. 1/10 (z := 1).
x: nat;
y: nat;
z: nat;
x = 1;
y = 1;
z = 0;
while (0 < x and 0 < y and z == 0) {
    {
        {
            {
                x = x - 1;
                y = y - 1;
            } [1/2] {
                x = x - 1;
            }
        } [2/5] {
            {
                y = y - 1;
            } [1/3] {
                {
                    y = y + 1;
                } [1/2] {
                    x = x + 1;
                }
            }
        }
    } [9/10] {
        z = 1;
    }
}
query Pr[x == 0 and y == 1 and z == 0];
query Pr[z == 1];
query Ex[x];
