# ADVERSARIAL: symmetric random walk (null-recurrent: AST but not PAST) with a noisy counter y.
# The distribution of y has a heavy tail, Pr(y >= k) ~ c/sqrt(k), so no finite-mass certificate is exact
# (Theorem "exact completeness") and geometric templates converge slowly.
x: nat;
y: nat;
x = 1;
y = 0;
while (x > 0) {
    {
        x = x - 1;
    } [1/2] {
        x = x + 1;
    }
    {
        y = y + 1;
    } [1/2] {
        skip;
    }
}
query Pr[y == 3];
query Pr[y >= 10];
query Pr[true];
