# Two-dimensional random walk in the quadrant with steps SW, W, S, N, E (uniform), no timeout.
# Drift (-1/5, -1/5) towards the axes: PAST.
x: nat;
y: nat;
x = 2;
y = 2;
while (0 < x and 0 < y) {
    {
        {
            x = x - 1;
            y = y - 1;
        } [1/2] {
            x = x - 1;
        }
    } [2/5] {
        {
            y = y - 1;
        } [1/3] {
            {
                y = y + 1;
            } [1/2] {
                x = x + 1;
            }
        }
    }
}
query Pr[x == 0 and y == 0];
query Pr[x == 0 and y >= 3];
query Ex[x];
