# Coupon collector with three coupons; k = number of distinct coupons, c = number of draws.
k: nat;
c: nat;
k = 0;
c = 0;
while (k < 3) {
    if (k == 0) {
        k = 1;
    } else if (k == 1) {
        {
            k = 2;
        } [2/3] {
            skip;
        }
    } else {
        {
            k = 3;
        } [1/3] {
            skip;
        }
    }
    c = c + 1;
}
query Ex[c];
