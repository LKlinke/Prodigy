# Retransmission protocol whose sender may crash: every failed attempt is retried, but with
# probability 1/10 the sender crashes (abort: the run never terminates).
# Non-AST (termination probability 5/6) because of divergence INSIDE the loop body.
d: nat;
c: nat;
d = 0;
c = 0;
while (d == 0) {
    {
        d = 1;
    } [1/3] {
        c = c + 1;
        {
            skip;
        } [9/10] {
            abort;
        }
    }
}
query Pr[c == 2];
query Ex[c];
