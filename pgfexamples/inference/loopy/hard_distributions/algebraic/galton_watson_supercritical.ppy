# main pgfexamples/inference/loopy/hard_distributions/algebraic/galton_watson_supercritical.ppy
# Total progeny of a supercritical Galton–Watson process: one ancestor, each individual has
# geometric(1/3) children (Pr[k] = (1/3)(2/3)^k, mean 2). The process dies out with probability
# q = 1/2, the smallest solution of q = 1/(3 - 2q) (Harris, "The Theory of Branching Processes",
# 1963); with probability 1/2 the loop does not terminate.
# The generating function T of the total progeny satisfies T = x/(3 - 2T), hence
#   T(x) = (3 - sqrt(9 - 8x))/4,   T(1) = 1/2.
# Class: algebraic PGF of a subdistribution, not AST (Pr[termination] = 1/2); the terminating
# part has finite moments (Ex[total] = T'(1) = 1).
#
# What Prodigy proves: unrolling gives sound intervals (the residual mass stays near 1/2). The
# kernel method gives the EVT invariant (infinite mass, since the loop runs forever with
# probability 1/2)
#   (alive^2*(3-2*alive) - total*(3-(9-8*total)^(1/2))/4)/(alive*(3-2*alive) - total);
# Prodigy confirms the fixed-point equation and computes (3 - sqrt(9 - 8 total))/4, but it cannot show
# that the coefficients are non-negative, so the result has no guarantee (#228).

alive: nat = 1;  # individuals whose children are not yet drawn
total: nat = 0;  # individuals so far; the result

while (alive > 0) {
    alive = alive - 1;
    total = total + 1;
    children: nat = geometric(1/3);
    alive = alive + children;
}
query Pr[true];  # expected: 1/2
query Pr[total == 1];  # expected: 1/3
query Pr[total == 2];  # expected: 2/27
query Ex[total];  # expected: 1
