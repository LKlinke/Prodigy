# main pgfexamples/inference/loop_free/conditioning/digitRecognition.ppy
y: nat;
tmp: nat;

tmp = bernoulli(98717/1000004);
if (tmp == 1) {
    y = 0;
} else {
    tmp = bernoulli(112370/901287);
    if (tmp == 1) {
        y = 1;
    } else {
        tmp = bernoulli(99300/788917);
        if (tmp == 1) {
            y = 2;
        } else {
            tmp = bernoulli(102180/689617);
            if (tmp == 1) {
                y = 3;
            } else {
                tmp = bernoulli(97367/587437);
                if (tmp == 1) {
                    y = 4;
                } else {
                    tmp = bernoulli(9035/49007);
                    if (tmp == 1) {
                        y = 5;
                    } else {
                        tmp = bernoulli(98633/399720);
                        if (tmp == 1) {
                            y = 6;
                        } else {
                            tmp = bernoulli(104420/301087);
                            if (tmp == 1) {
                                y = 7;
                            } else {
                                tmp = bernoulli(97517/196667);
                                if (tmp == 1) {
                                    y = 8;
                                } else {
                                    y = 9;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

