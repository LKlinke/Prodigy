# main pgfexamples/inference/loop_free/conditioning/caesar.ppy
key: nat;
randomChar: nat;
cipher: nat;
fail: nat;
param p: real;

key = unif(0, 5);

randomChar = unif(0, 5);
cipher = randomChar + key;
if (5 < cipher) {
    cipher = cipher - 5;
} else {
    skip;
}
fail = bernoulli(p);
if (fail == 1) {
    skip;
} else {
    observe(cipher == 4);
    skip;
}

#?Opt[cipher=4, p, MAX]
#!Print
