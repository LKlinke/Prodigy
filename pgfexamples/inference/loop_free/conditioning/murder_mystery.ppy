# main pgfexamples/inference/loop_free/conditioning/murder_mystery.ppy
aliceDunnit: nat;
withGun: nat;
param p: real;

aliceDunnit = bernoulli(3/10);
if (aliceDunnit == 1) {
    withGun = bernoulli(p);
} else {
    withGun = bernoulli(4/5);
}

observe(withGun == 1);
query Pr[aliceDunnit == 1];
#?Opt[aliceDunnit=1, p, MIN]
#!Print
